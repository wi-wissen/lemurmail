# Settings for the production container (docker-compose.yml). Copy to ".env" and edit.
# Lines starting with # are comments. After changes run: docker compose up -d

# --- Required -------------------------------------------------------------------------------------------------
# Public address of the app (behind your HTTPS reverse proxy)
APP_URL=https://tmp-mail.example.org
# The app's own subdomain; the MX record of this subdomain points to Lettermint inbound
MAIL_DOMAIN=tmp-mail.example.org
# Signing secret of the Lettermint inbound route
LETTERMINT_WEBHOOK_SECRET=

# --- Outgoing system mail (verification, password reset, approval). With Lettermint via HTTPS API (port 443): ---
# (plain SMTP also works - MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, ... - but many hosts block outgoing SMTP ports)
MAIL_MAILER=lettermint
# Lettermint project API token
LETTERMINT_PROJECT_TOKEN=
# An address on a sending domain verified in Lettermint
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME="Lemur Mail"

# --- ALTCHA captcha (registration, password reset, PIN login). Self-hosted, no account and no key needed. -------
ALTCHA_ENABLED=true

# --- Optional ---------------------------------------------------------------------------------------------------
# Notified when a teacher with an unknown school domain waits for approval
ADMIN_EMAIL=
# Full URLs of your legal pages; the footer links only appear when set
ABOUT_URL=https://lemurmail.wi7.net/
IMPRINT_URL=
PRIVACY_URL=
# Where the container is published on the host. Default: only on this machine, port 8080, for a reverse proxy.
# Direct plain-HTTP access on port 80 would be BIND_ADDRESS=0.0.0.0 and APP_PORT=80 (no TLS!).
#BIND_ADDRESS=127.0.0.1
#APP_PORT=8080
# Encryption key. Leave empty: it is created on the first start and stored in storage/app.key.
# Set it yourself (docker run --rm ghcr.io/wi-wissen/lemurmail:latest php artisan key:generate --show) if you
# want the key stored apart from the database, and keep a copy: without the key, stored secrets cannot be read.
APP_KEY=
# aligned (strict) | authenticated | off - see README. Relax it if mail of a legitimate service is rejected.
INBOUND_AUTH_MODE=aligned
# Language of the interface when the browser does not ask for one: de or en
APP_LOCALE=de
